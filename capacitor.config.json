{
  "appId": "com.zad.app",
  "appName": "Zad",
  "webDir": "dist",
  "android": {
    "backgroundColor": "#F8F4EA"
  },
  "plugins": {
    "LocalNotifications": {
      "iconColor": "#0F3D2E"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "swiftToolsVersion": "6.1",
        "packageTraits": {
          "@capacitor-firebase/authentication": [
            "Google"
          ]
        }
      }
    }
  }
}
