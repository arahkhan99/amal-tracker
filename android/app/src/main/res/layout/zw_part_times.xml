<?xml version="1.0" encoding="utf-8"?>
<!-- The day's five times (RemoteViews include): each name over its time, centred, with equal gaps between them, so the
     row stays even however wide the widget is (no AM/PM here: WidgetRenderer.times). The gold dot marks the prayer whose time is in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/zw_times" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top">
    <LinearLayout android:id="@+id/zw_t0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/zw_t0_dot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:src="@drawable/zw_dot_now"
                android:visibility="gone" android:importantForAccessibility="no" />
            <TextView android:id="@+id/zw_t0_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Fajr" android:textColor="@color/zw_ink2" android:textSize="12sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/zw_t0_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp"
            android:text="5:52" android:textColor="@color/zw_ink" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:minWidth="4dp" />
    <LinearLayout android:id="@+id/zw_t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/zw_t1_dot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:src="@drawable/zw_dot_now"
                android:visibility="gone" android:importantForAccessibility="no" />
            <TextView android:id="@+id/zw_t1_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Zuhr" android:textColor="@color/zw_ink2" android:textSize="12sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/zw_t1_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp"
            android:text="11:56" android:textColor="@color/zw_ink" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:minWidth="4dp" />
    <LinearLayout android:id="@+id/zw_t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/zw_t2_dot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:src="@drawable/zw_dot_now"
                android:visibility="visible" android:importantForAccessibility="no" />
            <TextView android:id="@+id/zw_t2_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ʿAsr" android:textColor="@color/zw_ink2" android:textSize="12sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/zw_t2_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp"
            android:text="2:21" android:textColor="@color/zw_ink" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:minWidth="4dp" />
    <LinearLayout android:id="@+id/zw_t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/zw_t3_dot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:src="@drawable/zw_dot_now"
                android:visibility="gone" android:importantForAccessibility="no" />
            <TextView android:id="@+id/zw_t3_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Maghrib" android:textColor="@color/zw_ink2" android:textSize="12sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/zw_t3_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp"
            android:text="4:05" android:textColor="@color/zw_ink" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:minWidth="4dp" />
    <LinearLayout android:id="@+id/zw_t4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/zw_t4_dot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:src="@drawable/zw_dot_now"
                android:visibility="gone" android:importantForAccessibility="no" />
            <TextView android:id="@+id/zw_t4_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ʿIshāʾ" android:textColor="@color/zw_ink2" android:textSize="12sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/zw_t4_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp"
            android:text="5:40" android:textColor="@color/zw_ink" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
