            <TextView android:id="@+id/zw_r0_solo" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center" android:background="@drawable/zw_bg_btn1" android:visibility="gone"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:text="On time" android:textColor="@color/zw_btn1_label" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/zw_r0_remember" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center" android:background="@drawable/zw_bg_btn1" android:visibility="gone"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:text="Remembrance" android:textColor="@color/zw_btn1_label" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        <LinearLayout android:id="@+id/zw_r0_logged" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/zw_r0_logged_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="On time ✓" android:textColor="@color/zw_ink2" android:textSize="13sp" android:maxLines="1" />
            <TextView android:id="@+id/zw_r0_undo" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="8dp" android:gravity="center" android:background="@drawable/zw_bg_btn2"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:text="Undo" android:textColor="@color/zw_btn2_label" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/zw_line" />
