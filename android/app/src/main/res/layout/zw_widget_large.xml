<?xml version="1.0" encoding="utf-8"?>
<!-- Large widget (RemoteViews): the current prayer and the day's five prayers, each open one with its one-tap buttons. Filled in by WidgetRenderer.java. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/zw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/zw_bg_card" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:id="@+id/zw_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/zw_tag_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/zw_dot_now" android:importantForAccessibility="no" />
                <TextView android:id="@+id/zw_tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                    android:text="Now" android:textColor="@color/zw_ink2" android:textSize="13sp" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/zw_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="serif" android:text="ʿAsr" android:textColor="@color/zw_ink" android:textSize="28sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="end">
            <Chronometer android:id="@+id/zw_countdown" android:countDown="true" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/zw_ink" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/zw_countdown_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="left · until 16:05" android:textColor="@color/zw_ink2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <!-- Only when the open prayer isn't one of today's rows (last night's ʿIshāʾ, after midnight) -->
    <FrameLayout android:id="@+id/zw_bottom_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:visibility="gone">
        <include layout="@layout/zw_part_actions" />
    </FrameLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="@drawable/zw_line" />
    <LinearLayout android:id="@+id/zw_r0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="40dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/zw_r0_icon" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/zw_st_ontime" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/zw_r0_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Fajr" android:textColor="@color/zw_ink" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/zw_r0_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="05:52" android:textColor="@color/zw_ink2" android:textSize="12sp" android:maxLines="1" />
        </LinearLayout>
        <TextView android:id="@+id/zw_r0_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="On time" android:textColor="@color/zw_ink2" android:textSize="13sp" android:maxLines="1" />
        <LinearLayout android:id="@+id/zw_r0_btns" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/zw_r0_cong" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center" android:background="@drawable/zw_bg_btn1"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:text="Congregation" android:textColor="@color/zw_btn1_label" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/zw_r0_ontime" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/zw_bg_btn2"
