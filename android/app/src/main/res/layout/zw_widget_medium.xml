<?xml version="1.0" encoding="utf-8"?>
<!-- Medium widget (RemoteViews): the current prayer, its countdown, the one-tap buttons (brothers: Congregation and On time; sisters: On time) and the day's five dots. Filled in by WidgetRenderer.java. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/zw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/zw_bg_card" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/zw_tag_dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/zw_dot_now" android:importantForAccessibility="no" />
            <TextView android:id="@+id/zw_tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="Now" android:textColor="@color/zw_ink2" android:textSize="13sp" android:maxLines="1" />
        </LinearLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:id="@+id/zw_dots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/zw_dot0" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="0dp"
                android:src="@drawable/zw_dot_ontime" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/zw_dot1" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="5dp"
                android:src="@drawable/zw_dot_congregation" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/zw_dot2" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="5dp"
                android:src="@drawable/zw_dot_open" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/zw_dot3" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="5dp"
                android:src="@drawable/zw_dot_empty" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/zw_dot4" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="5dp"
                android:src="@drawable/zw_dot_empty" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/zw_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/zw_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="serif" android:text="ʿAsr" android:textColor="@color/zw_ink" android:textSize="30sp" android:maxLines="1" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="end">
            <Chronometer android:id="@+id/zw_countdown" android:countDown="true" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/zw_ink" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/zw_countdown_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="left · until 16:05" android:textColor="@color/zw_ink2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="6dp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <include layout="@layout/zw_part_actions" />
        <LinearLayout android:id="@+id/zw_times_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="8dp" android:background="@drawable/zw_line" />
            <include layout="@layout/zw_part_times" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
