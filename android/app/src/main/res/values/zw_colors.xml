<?xml version="1.0" encoding="utf-8"?>
<!-- Widget colours: OG Calm (design-review/mockups2/redesign/final/og/NOTES.md, variant A). Light here, dark in
     values-night (the launcher redraws the widget in the phone's light or dark mode). Every text pair passes WCAG AA. -->
<resources>
    <color name="zw_card">#FFFDF8</color>
    <color name="zw_ink">#17231E</color>
    <color name="zw_ink2">#56625B</color>
    <color name="zw_ink3">#5F6A63</color>
    <color name="zw_line">#EAE1CC</color>
    <!-- Primary button (forest, honey label) and secondary (soft green tint, forest label) -->
    <color name="zw_btn1">#0F3D2E</color>
    <color name="zw_btn1_label">#E5C55C</color>
    <color name="zw_btn2">#E3EBE0</color>
    <color name="zw_btn2_label">#0F3D2E</color>
    <!-- Gold "now" mark (deeper in light mode so it reaches 3:1) -->
    <color name="zw_now">#A9821A</color>
    <!-- Status marks and dots -->
    <color name="zw_congregation">#0F3D2E</color>
    <color name="zw_congregation_mark">#E5C55C</color>
    <color name="zw_ontime">#E3EBE0</color>
    <color name="zw_ontime_mark">#0F3D2E</color>
    <color name="zw_ontime_dot">#5E9A7E</color>
    <color name="zw_madeup">#4F6D8A</color>
    <color name="zw_missed">#9E3F2C</color>
    <color name="zw_excused">#8E9C94</color>
    <color name="zw_mark_ink">#FFFFFF</color>
    <color name="zw_ring">#A39D8C</color>
</resources>
