<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Crash reports are opt-in (privacy audit B1): nothing is collected until the user says yes, then
             src/crash.js turns collection on with FirebaseCrashlytics.setEnabled at runtime. -->
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- zad://log?p=Asr&d=2026-11-05 and friends: opened by the home-screen widgets
                 (src/widget-bridge.js handles them through @capacitor/app appUrlOpen). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="zad" />
            </intent-filter>

        </activity>

        <!-- Home-screen widgets (docs/build/widgets.md). They read the snapshot the app writes
             through the ZadWidgets plugin. -->
        <receiver android:name=".widget.ZadSmallWidgetProvider" android:exported="false" android:label="Zad · Next prayer">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/zw_widget_small_info" />
        </receiver>
        <receiver android:name=".widget.ZadMediumWidgetProvider" android:exported="false" android:label="Zad · Today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/zw_widget_medium_info" />
        </receiver>
        <receiver android:name=".widget.ZadLargeWidgetProvider" android:exported="false" android:label="Zad · Today and Good Deeds">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/zw_widget_large_info" />
        </receiver>
        <!-- Boundary tick (next prayer / end of window), and redraws when the clock, time zone or the
             exact-alarm permission changes -->
        <receiver android:name=".widget.WidgetTickReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions. Every one below is used by the app. Libraries merge in a few more (see
         android/app/build/outputs/logs/manifest-merger-*-report.txt): USE_FINGERPRINT
         (androidx.biometric, Android 9 and older), ACCESS_NETWORK_STATE (Firebase Auth,
         geolocation) and READ_GSERVICES (reCAPTCHA inside Firebase Auth). -->

    <!-- Google sign-in and cloud backup (Firebase Auth + Firestore), and the city-name lookup. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Prayer times are calculated on the phone from its location (src/platform.js
         currentPosition). Network (coarse) location is tried first; fine location is the GPS
         fallback when no network location is available. On Android 12+ the user can still pick
         "Approximate". -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Prayer reminders (@capacitor/local-notifications, src/notify.js) -->
    <!-- Show the reminders (asked at runtime on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arm the scheduled reminders after the phone restarts (the plugin's boot receiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- On-time reminders. Pre-granted on Android 12-13; on Android 14+ the user allows it under
         "Alarms & reminders". Without it the plugin falls back to an inexact alarm
         (setAndAllowWhileIdle), so a reminder can arrive a few minutes late. Not capped with
         maxSdkVersion: the plugin needs it declared on every version to check or ask for it.
         USE_EXACT_ALARM is deliberately not used: Google Play reserves it for alarm-clock and
         calendar apps. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- The notifications plugin declares WAKE_LOCK but never takes a wake lock (its alarms are
         RTC_WAKEUP, which the system covers while the receiver runs), so drop it. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />

    <!-- Optional app lock with fingerprint, face or the screen lock (@aparajita/capacitor-biometric-auth). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
