rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own tracker data.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Moon-sighting committees for the Hijri date. Everyone signed in can read; only the committee's editors
    // (uids listed in the committee document's "editors" array) can write a month. The committee document itself
    // (name, editors) is managed in the Firebase console, never from the app.
    match /hijriCommittees/{committeeId} {
      allow read: if request.auth != null;
      match /months/{monthId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && request.auth.uid in get(/databases/$(database)/documents/hijriCommittees/$(committeeId)).data.editors
          && request.resource.data.keys().hasOnly(['startDate', 'updatedBy', 'updatedAt', 'note'])
          && request.resource.data.keys().hasAll(['startDate', 'updatedBy', 'updatedAt'])
          && request.resource.data.startDate is string
          && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.get('note', '') is string
          && request.resource.data.get('note', '').size() <= 200;
      }
    }
  }
}
